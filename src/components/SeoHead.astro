---
/**
 * SEOHead Component
 * Centralizes SEO meta tags and JSON-LD schemas injection
 *
 * Usage:
 * <SEOHead
 *   seoProps={seoData}
 *   schemas={[ORGANIZATION_SCHEMA, breadcrumbSchema, faqSchema]}
 * />
 */

import { SEO } from "astro-seo";
import type { SEOProps } from "astro-seo";
import type { JSONLDSchema } from "@/config/seoConf";

interface Props {
  seoProps: SEOProps;
  schemas?: JSONLDSchema[];
  notFound?: boolean;
}

const { seoProps, schemas = [], notFound = false } = Astro.props;
---

<!-- SEO Meta Tags -->{
  notFound ? (
    // astro-seo always emits a canonical; the 404 must have none
    <>
      <title>{seoProps.title}</title>
      {seoProps.description && (
        <meta name="description" content={seoProps.description} />
      )}
      <meta name="robots" content="noindex, follow" />
    </>
  ) : (
    <SEO {...seoProps} />
  )
}

<!-- JSON-LD Structured Data -->
{
  schemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))
}
